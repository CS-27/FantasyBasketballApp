# App Settings
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
# Local development only: enables /auth/dev-login and allows a missing SECRET_KEY
# DEV_MODE=true
BASE_URL=http://localhost:8000

# Database (SQLite default, change to PostgreSQL for production)
DATABASE_URL=sqlite:///./fantasy.db

# Yahoo OAuth (register at https://developer.yahoo.com/apps/)
# The app needs Fantasy Sports read access, which Yahoo grants by application:
# https://sports.yahoo.com/developer/access/
# YAHOO_REDIRECT_URI must exactly match a redirect URI registered on the app.
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret
YAHOO_REDIRECT_URI=http://localhost:8000/auth/callback

# Stripe (get keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
